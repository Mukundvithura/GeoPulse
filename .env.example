# GeoPulse environment overrides.
#
# Nothing in the app reads this file: there is no dotenv dependency, by
# decision. These are plain environment variables, so export them in your
# shell before running the API or a collector.
#
#   PowerShell:  $env:GEOPULSE_DB_URL = "postgresql://user:pass@host:5432/db"
#   bash:        export GEOPULSE_DB_URL="postgresql://user:pass@host:5432/db"
#
# Every variable here is optional. With none of them set the app runs against
# the local docker-compose stack with no setup at all.

# Postgres connection string, read once in config.py and shared by the API and
# all four collectors. The default below is what you get when it is unset.
# Port 6543 is deliberate -- it keeps a local Postgres on 5432 out of the way.
GEOPULSE_DB_URL=postgresql://geopulse:geopulse@localhost:6543/geopulse
